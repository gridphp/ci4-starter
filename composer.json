{
    "name": "gridphp/ci4-starter",
    "description": "CodeIgniter 4 starter pre-wired for GridPHP (grid.jqgrid) integration, per https://www.gridphp.com/docs/integrations/codeigniter-integration/",
    "license": "MIT",
    "type": "project",
    "homepage": "https://gridphp.com",
    "support": {
        "docs": "https://www.gridphp.com/docs/integrations/codeigniter-integration/",
        "forum": "https://www.gridphp.com/support",
        "source": "https://github.com/gridphp/gridphp-community"
    },
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",   
        "gridphp/gridphp-community": "^1.0.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "classmap": ["composer_script.php"],
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "gridphp:publish": "ComposerScript::publishAssets",
        "post-install-cmd": [
            "ComposerScript::fetchCoreFiles",
            "ComposerScript::publishAssets"
        ],
        "post-update-cmd": [
            "ComposerScript::fetchCoreFiles",
            "ComposerScript::publishAssets"
        ],
        "post-create-project-cmd": [
            "ComposerScript::setupEnv",
            "ComposerScript::showSuccessBanner"
        ]
    }
}
